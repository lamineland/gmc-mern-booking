PORT=5050
NODE_ENV=development

# Must be a replica set (MongoDB Atlas, or a local single-node replica set):
# bookings are created inside a transaction to prevent double booking.
MONGODB_URI=mongodb://127.0.0.1:27017/booking-app?replicaSet=rs0

CLIENT_URL=http://localhost:5173

# Use long random strings, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Platform-wide rule: clients can cancel up to this many hours before start
CANCELLATION_CUTOFF_HOURS=2

# Default timezone for new businesses and for the owner "all businesses" dashboard
DEFAULT_TIMEZONE=UTC

# Used by `npm run seed` to create the first admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin
