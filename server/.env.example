PORT=5050
NODE_ENV=development
# Public URL of this API (payment redirects and webhooks). Defaults to http://localhost:$PORT
# API_URL=http://localhost:5050

# Must be a replica set (MongoDB Atlas, or a local single-node replica set):
# bookings are created inside a transaction to prevent double booking.
MONGODB_URI=mongodb://127.0.0.1:27017/winpitch?replicaSet=rs0

CLIENT_URL=http://localhost:5173

# Use long random strings, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Launch market (PRD §1.3)
DEFAULT_TIMEZONE=Africa/Dakar

# Initial values of the platform settings (the admin can change them afterwards)
CANCELLATION_CUTOFF_HOURS=2
HOLD_MINUTES=10
DEFAULT_COMMISSION_RATE=0.1

# Payments (PRD §6): "mock" until a real provider account exists. The mock is never loaded in production.
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=change-me-mock-webhook
# Force every mock payment to succeed / fail / never answer (empty = use the test phone numbers)
MOCK_PAYMENT_AUTO=

# Used by `npm run seed` to create the first admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin
ADMIN_PHONE=+221770000000
